---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="Home" description="Ray's personal blog - Solution Architect, Site Reliability Engineer, Tech Enthusiast">
  <div class="hero">
    <pre class="ascii-art">
    ____              ____  ____  ______
   / __ \____ ___  __/ __ \/ __ )/ ____/
  / /_/ / __ `/ / / / / / / __  / / __  
 / _, _/ /_/ / /_/ / /_/ / /_/ / /_/ /  
/_/ |_|\__,_/\__, /_____/_____/\____/   
            /____/                      v2.0
    </pre>
    <p class="tagline">
      <span class="prompt">$ whoami</span>
    </p>
    <p class="bio">
      Solution Architect, Life Debugger.
    </p>
  </div>

  <section class="quick-links">
    <h2 class="section-title">
      <span class="prompt">$ ls -la</span> ./quick-links
    </h2>
    <ul class="link-list">
      <li>
        <span class="prompt">$ cd</span> <a href="/blog">/blog</a>
        <span class="desc">- thoughts and tutorials</span>
      </li>
      <li>
        <span class="prompt">$ cd</span> <a href="/about">/about</a>
        <span class="desc">- more about me</span>
      </li>
      <li>
        <span class="prompt">$ cd</span> <a href="https://github.com/adamus7/raydbg-blog-build">/github</a>
        <span class="desc">- source code</span>
      </li>
    </ul>
  </section>

  <section class="latest-posts">
    <h2 class="section-title">
      <span class="prompt">$ tail</span> -f recent-posts.log
    </h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <span class="date">{post.data.pubDate.toISOString().split('T')[0]}</span>
          <span class="prompt">-&gt;</span>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    {posts.length === 0 && (
      <p class="empty-message">No posts yet...</p>
    )}
    <p class="more-link">
      <a href="/blog">[ view all posts ]</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: left;
    padding: 2rem 0 3rem;
  }

  .ascii-art {
    font-size: 10px;
    line-height: 1.2;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .tagline {
    margin-bottom: 1rem;
  }

  .bio {
    color: var(--text-secondary);
  }

  .section-title {
    font-size: 1rem;
    font-weight: normal;
    margin-bottom: 1.5rem;
    color: var(--text-secondary);
  }

  .quick-links {
    margin-bottom: 3rem;
  }

  .link-list, .post-list {
    list-style: none;
    padding: 0;
  }

  .link-list li, .post-list li {
    margin: 0.75rem 0;
  }

  .desc {
    color: var(--text-muted);
  }

  .date {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-right: 0.5rem;
  }

  .more-link {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  .empty-message {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 540px) {
    .ascii-art {
      font-size: 8px;
    }
  }
</style>