---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About RayDBG">
  <div class="about-header">
    <pre class="ascii-art">
  ___                  _   _
 / _ \ _ __   ___  ___| |_| |
| | | | '_ \ / _ \/ __| __| |
| |_| | | | |  __/\__ \ |_|_|
 \___/|_| |_|\___||___/\__(_)
    </pre>
  </div>

  <section class="profile">
    <div class="profile-header">
      <img src="/avatar/avatar-0.jpg" alt="RayDBG Avatar" class="avatar" />
      <div class="profile-info">
        <p class="prompt">$ cat README.md</p>
        <p>
          Hi, I'm Ray. I'm a Solution Architect passionate about building
          elegant solutions to complex problems.
        </p>
      </div>
    </div>
  </section>

  <section class="about-content">
    <h2 class="section-title">
      <span class="prompt">$ whoami</span> --long
    </h2>
    <ul class="info-list">
      <li><span class="label">Location:</span> @Shanghai</li>
      <li><span class="label">Interests:</span> Programming, System Design, Open Source</li>
      <li><span class="label">Skills:</span> Eat, Sleep, Think </li>
    </ul>

    <h2 class="section-title">
      <span class="prompt">$ cat</span> contact.txt
    </h2>
    <ul class="contact-list">
      <li>
        <span class="prompt">$</span>
        <a href="https://github.com/adamus7">GitHub</a>
      </li>
      <li>
        <span class="prompt">$</span>
        <a href="mailto:adamus_7@outlook.com">Email</a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .about-header {
    margin-bottom: 2rem;
  }

  .ascii-art {
    font-size: 10px;
    line-height: 1.15;
    color: var(--text-secondary);
  }

  .profile {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
  }

  .profile-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .avatar {
    width: 100px;
    height: 100px;
    border-radius: 4px;
    border: 2px solid var(--border);
    flex-shrink: 0;
  }

  .profile-info p {
    margin-bottom: 0.75rem;
  }

  .profile-info p:first-child {
    margin-bottom: 0.5rem;
  }

  .about-content {
    max-width: 600px;
  }

  .section-title {
    font-size: 1rem;
    font-weight: normal;
    margin: 2rem 0 1rem;
    color: var(--text-secondary);
  }

  .info-list, .contact-list {
    list-style: none;
    padding: 0;
  }

  .info-list li, .contact-list li {
    margin: 0.5rem 0;
  }

  .label {
    color: var(--text-muted);
  }

  @media (max-width: 540px) {
    .profile-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .avatar {
      width: 80px;
      height: 80px;
    }
  }
</style>